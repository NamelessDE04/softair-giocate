rules_version = '2';
// Regole di sicurezza Firestore per Airsoft Conflict.
// Da incollare in console Firebase → Firestore Database → Regole → Pubblica.
// Ruoli: developer (vaisittiluca@gmail.com, può tutto) · organizzatore · comandante · caposquadra · truppa.
// Cosa può fare ogni ruolo lo decide il developer nella tabella config/permessi.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function isDev() {
      return signed()
        && request.auth.token.email == 'vaisittiluca@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function meRef() { return /databases/$(database)/documents/utenti/$(request.auth.uid); }
    function myTeam() { return exists(meRef()) ? get(meRef()).data.get('team', null) : null; }
    function ruolo() { return exists(meRef()) ? get(meRef()).data.get('ruolo', 'truppa') : 'truppa'; }
    function permRef() { return /databases/$(database)/documents/config/permessi; }
    // permessi predefiniti se il developer non ha ancora salvato la tabella
    function predefiniti() {
      return {
        'organizzatore': { 'conflitti': true, 'allenamenti': true, 'mappe': true, 'team': true, 'giocatori': true, 'rosa': true, 'ordini': true },
        'comandante': { 'rosa': true, 'ordini': true },
        'caposquadra': { 'rosa': true },
        'truppa': { 'rosa': true }
      };
    }
    function ruoloT() { return ruolo() == null ? 'truppa' : ruolo(); }
    // permesso dalla tabella del developer; se nella tabella manca (permesso nuovo) vale quello predefinito
    function perm(p) {
      return isDev() || (signed()
        && (exists(permRef()) ? get(permRef()).data : predefiniti()).get(ruoloT(), {}).get(p, predefiniti().get(ruoloT(), {}).get(p, false)) == true);
    }
    function invito(cod) { return /databases/$(database)/documents/inviti/$(cod); }
    function isRef(tid) {
      return signed() && tid != null
        && get(/databases/$(database)/documents/team/$(tid)).data.get('referenteUid', null) == request.auth.uid;
    }
    function ruoloInvariato() { return request.resource.data.get('ruolo', null) == resource.data.get('ruolo', null); }
    // il ruolo e il permesso temporaneo di posare i QR non se li dà da solo nessuno
    function permessiInvariati() { return ruoloInvariato() && request.resource.data.get('posaQrFino', null) == resource.data.get('posaQrFino', null); }
    // nome, cognome ed email non stanno nel profilo pubblico (vanno in privati/{uid}): si possono solo togliere
    function senzaNomi() {
      return !request.resource.data.keys().hasAny(['nome', 'email'])
        || (resource != null && request.resource.data.get('nome', null) == resource.data.get('nome', null)
            && request.resource.data.get('email', null) == resource.data.get('email', null));
    }
    // telefoni dei referenti: chi li vede lo decide il developer (config/privacy)
    function regolaTel() {
      return exists(/databases/$(database)/documents/config/privacy)
        ? get(/databases/$(database)/documents/config/privacy).data.get('telefoni', { 'tutti': true })
        : { 'tutti': true };
    }
    function vedeTelefoni() {
      return signed() && (regolaTel().get('tutti', false) == true
        || ruoloT() == 'organizzatore'
        || (regolaTel().get('referenti', false) == true && isRef(myTeam()))
        || (regolaTel().get('comandante', false) == true && ruoloT() == 'comandante')
        || (regolaTel().get('caposquadra', false) == true && ruoloT() == 'caposquadra'));
    }
    function posaQr() { return perm('mappe') || (signed() && exists(meRef()) && get(meRef()).data.get('posaQrFino', 0) > request.time.toMillis()); }

    // Tabella dei permessi: la leggono tutti, la cambia solo il developer
    match /config/{doc} {
      allow read: if signed();
      allow write: if isDev();
    }

    // Profili. Il ruolo lo assegna solo il developer.
    match /utenti/{uid} {
      allow read: if perm('giocatori') || perm('conflitti')
        || (signed() && request.auth.uid == uid)
        || (signed() && resource.data.get('team', null) != null && resource.data.get('team', null) == myTeam()
            && (perm('rosa') || isRef(myTeam())));
      allow create: if signed() && request.auth.uid == uid && senzaNomi()
        && request.resource.data.get('team', null) == null && request.resource.data.get('ruolo', null) == null;
      allow update: if isDev()
        || (perm('giocatori') && ruoloInvariato() && senzaNomi())
        // chi elimina un team toglie i giocatori dal team
        || (perm('team') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['squadra', 'team', 'codice'])
            && request.resource.data.get('team', null) == null)
        || (signed() && request.auth.uid == uid && permessiInvariati() && senzaNomi() && (
          request.resource.data.get('team', null) == resource.data.get('team', null)
          || request.resource.data.get('team', null) == null
          || (request.resource.data.get('codice', null) is string
              && exists(invito(request.resource.data.codice))
              && get(invito(request.resource.data.codice)).data.team == request.resource.data.team)))
        || (isRef(resource.data.get('team', null))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['squadra', 'team', 'codice'])
          && (request.resource.data.get('team', null) == resource.data.get('team', null) || request.resource.data.get('team', null) == null));
      allow delete: if perm('giocatori');
    }

    // Nome, cognome ed email: solo il giocatore stesso e chi organizza
    match /privati/{uid} {
      allow read: if (signed() && request.auth.uid == uid) || perm('giocatori') || perm('conflitti');
      allow create, update: if ((signed() && request.auth.uid == uid) || perm('giocatori'))
        && request.resource.data.keys().hasOnly(['nome', 'email']);
      allow delete: if perm('giocatori');
    }

    // Allenamenti a porte chiuse: li vedono solo i team invitati
    match /allenamenti/{id} {
      allow read: if perm('allenamenti') || (signed() && myTeam() != null && myTeam() in resource.data.team);
      allow write: if perm('allenamenti');
      // risposte all'invito: ognuno la sua; tutte chi organizza
      match /adesioni/{uid} {
        function inv() { return signed() && myTeam() != null && myTeam() in get(/databases/$(database)/documents/allenamenti/$(id)).data.team; }
        allow read: if perm('allenamenti') || (signed() && request.auth.uid == uid);
        allow create, update: if inv() && request.auth.uid == uid && request.resource.data.team == myTeam();
        allow delete: if perm('allenamenti') || (signed() && request.auth.uid == uid);
      }
    }

    // Combat a scenari (PCS): li prepara chi organizza
    match /scenari/{id} {
      allow read, write: if perm('conflitti');
    }

    // DMZ: la prepara il developer; la vedono solo i giocatori messi nelle squadre
    match /dmz/{id} {
      allow read: if isDev() || (signed() && request.auth.uid in resource.data.giocatori);
      allow write: if isDev();
      // partita: contratti, estrazioni, eliminazioni, solo per la propria squadra e nell'orario
      match /eventi/{eid} {
        function d() { return get(/databases/$(database)/documents/dmz/$(id)).data; }
        allow read: if isDev() || (signed() && request.auth.uid in d().giocatori);
        allow create: if signed() && request.auth.uid in d().giocatori
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.squadra == d().squadraDi[request.auth.uid]
          && request.resource.data.t is number
          && request.resource.data.tipo in ['prendi', 'lascia', 'qr', 'eliminata']
          && request.time.toMillis() >= d().inizio - 600000
          && request.time.toMillis() <= d().fine + 600000;
        allow delete: if isDev();
      }
    }

    // Cartine dei campi (aree e collegamenti) e immagine divisa a pezzi
    match /campi/{id} {
      allow read: if signed();
      allow write: if perm('mappe');
      match /img/{n} {
        allow read: if signed();
        allow write: if perm('mappe') && request.resource.data.d.size() < 1000000;
        allow delete: if perm('mappe');
      }
    }

    // Codici dei QR delle aree (per stamparli): solo chi gestisce le cartine. Nel campo c'è solo l'impronta.
    match /campiQr/{id} {
      allow read, write: if perm('mappe');
    }
    // Posa dei QR sul campo: chi li ha messi e dove
    match /campiPosa/{id} {
      allow read: if signed();
      allow write: if posaQr();
    }

    // Anagrafica dei team (nome, logo, referente, squadre)
    match /team/{tid} {
      allow read: if signed();
      allow create, delete: if perm('team');
      allow update: if (perm('team')
          || (signed() && resource.data.get('referenteUid', null) == request.auth.uid
              && request.resource.data.get('referenteUid', null) == resource.data.get('referenteUid', null)))
        && request.resource.data.get('logo', '').size() < 300000;
    }
    // Cellulare del referente: chi organizza, il referente stesso e chi permette la regola del developer
    match /contatti/{tid} {
      allow read: if perm('team') || isRef(tid) || vedeTelefoni();
      allow write: if perm('team') || isRef(tid);
    }

    // Codici d'invito: si legge un codice solo conoscendolo
    match /inviti/{cod} {
      allow get: if signed();
      allow list, write: if perm('team');
    }
    match /codiciTeam/{tid} {
      allow read: if perm('team') || isRef(tid);
      allow write: if perm('team');
    }

    // Conflict: li vedono i team invitati e chi li organizza
    match /conflitti/{cid} {
      function c() { return get(/databases/$(database)/documents/conflitti/$(cid)).data; }
      function invitato() { return signed() && myTeam() != null && myTeam() in c().team; }
      allow read: if perm('conflitti') || (signed() && myTeam() != null && myTeam() in resource.data.team);
      // chi elimina un team lo toglie anche dai conflict
      allow update: if perm('conflitti')
        || (perm('team') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team', 'fazioneDi', 'fazioni']));
      allow create, delete: if perm('conflitti');

      match /bacheca/{pid} {
        allow read: if perm('conflitti') || invitato();
        allow create, update: if perm('conflitti') && request.resource.data.get('img', '').size() < 900000;
        allow delete: if perm('conflitti');
      }

      // Maglia radio: il canale comune lo vedono tutti gli invitati, quella di una fazione solo i suoi giocatori
      match /radio/{doc} {
        allow read: if perm('conflitti') || (invitato() && (doc == 'comune'
          || doc == c().get('fazioneUtente', {}).get(request.auth.uid, c().fazioneDi[myTeam()])));
        allow write: if perm('conflitti');
      }

      // Risposte agli inviti: ognuno vede la sua; tutte solo chi organizza
      match /adesioni/{uid} {
        allow read: if perm('conflitti') || (invitato() && request.auth.uid == uid);
        allow create, update: if invitato() && request.auth.uid == uid && request.resource.data.team == myTeam();
        allow delete: if perm('conflitti') || (signed() && request.auth.uid == uid);
      }

      // Partita: posizione nei punti e ordini, solo per la propria fazione e nell'orario del conflict
      match /eventi/{eid} {
        allow read: if perm('conflitti') || invitato();
        allow create: if invitato()
          && request.resource.data.uid == request.auth.uid
          // in addestramento la fazione è del singolo giocatore (attacco o difesa), altrimenti del suo team
          && request.resource.data.team == c().get('fazioneUtente', {}).get(request.auth.uid, c().fazioneDi[myTeam()])
          && request.resource.data.t is number
          && request.time.toMillis() >= c().inizio - 3600000
          && request.time.toMillis() <= c().fine + 12 * 3600000
          && (request.resource.data.tipo == 'zona'
              || request.resource.data.tipo in ['rif', 'richiesta', 'fuoco']
              // il mortaio lo costruiscono capisquadra e comandanti
              || (request.resource.data.tipo == 'mortaio' && (ruoloT() in ['caposquadra', 'comandante'] || perm('ordini')
                  || c().get('comandanti', {}).get(request.resource.data.team, 'ia') == request.auth.uid))
              || (request.resource.data.tipo == 'ordine'
                  && (c().get('comandanti', {}).get(request.resource.data.team, 'ia') == request.auth.uid || perm('ordini'))));
        allow delete: if perm('conflitti');
      }
    }
  }
}
